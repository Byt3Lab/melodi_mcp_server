# Configuration du Serveur MCP MELODI

# --- Connexion MELODI ERP ---
MELODI_BASE_URL=http://localhost:8000
# Préfixe personnalisable des endpoints de l'API MCP MELODI (par défaut: /api/melodi_mcp/internal)
MELODI_API_PREFIX=/api/melodi_mcp
# Clé d'API secrète pour s'authentifier auprès de MELODI ERP (par défaut: mcp-internal-secret-token)
MELODI_API_KEY=mcp-internal-secret-token
MELODI_TIMEOUT_SECONDS=30.0
MELODI_VERIFY_SSL=true

# --- Protocole & Transport MCP ---
# Mode de transport : "stdio" (local, pour Claude Desktop / CLI) ou "http" (SSE / web)
MCP_TRANSPORT=stdio
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765
# Clé secrète de signature/chiffrement JWT (HMAC-SHA256) partagée avec MELODI ERP :
# Les clients MCP envoient un unique en-tête 'Authorization: Bearer <jwt>'.
# Le payload JWT contient obligatoirement {"mcp_api_key": "...", "user_id": "..."}.
MCP_JWT_SECRET=
# Clé d'infrastructure MCP optionnelle (validée contre le claim 'mcp_api_key' du JWT si définie) :
MCP_API_KEY=

# --- Console Web d'Administration ---
ADMIN_DASHBOARD_ENABLED=true
ADMIN_PREFIX=/admin
# Clé d'amorçage initiale pour créer le premier compte admin (par défaut: admin)
ADMIN_API_KEY=admin
# Chemin du fichier SQLite pour la persistance des utilisateurs
ADMIN_DB_PATH=data/admin.db
# Durée de validité des sessions en heures
ADMIN_SESSION_TTL_HOURS=24

# --- Gestion du Catalogue & Sécurité ---
# Intervalle de synchronisation périodique automatique en secondes
CATALOG_SYNC_INTERVAL_SECONDS=60
# Limite maximale des arguments reçus (en octets, défaut: 1 Mo)
MAX_REQUEST_SIZE_BYTES=1048576
# Limite maximale des résultats retournés (en octets, défaut: 5 Mo)
MAX_RESPONSE_SIZE_BYTES=5242880

# --- Journalisation ---
LOG_LEVEL=INFO
